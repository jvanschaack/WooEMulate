{
  "name": "wooemulate",
  "version": "0.1.0",
  "description": "Turn any custom, headless, or serverless store into a WooCommerce REST API v3 facade for Pirate Ship, ShipStation, and more.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "node tests/test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "woocommerce",
    "pirateship",
    "shipstation",
    "ecommerce",
    "headless",
    "rest-api",
    "emulator",
    "nextjs",
    "astro",
    "cloudflare-workers"
  ],
  "author": "WooEMulate Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
